<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WowStopwatcher.App.Controls"
        xmlns:vm="using:WowStopwatcher.App.ViewModels"
        xmlns:v="using:WowStopwatcher.App.Views"
        x:Class="WowStopwatcher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.ico"
        Title="WowStopwatcher"
        Width="1200"
        Height="880"
        MinWidth="760"
        MaxWidth="1200"
        CanMaximize="False"
        MinHeight="480"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="14">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:TodayViewModel">
      <v:TodayView />
    </DataTemplate>
    <DataTemplate DataType="vm:StatisticsViewModel">
      <v:StatisticsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <v:SettingsView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid>
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Padding="28,12"
              Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <c:Icon Width="26" Height="26"
                    Data="{StaticResource IconLogo}"
                    Stroke="{DynamicResource TextBrush}" />
            <TextBlock Text="WowStopwatcher"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="Bold"
                       LetterSpacing="-0.16" />
            <TextBlock Text="{Binding DateText}"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Classes="muted" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="nav"
                    Classes.active="{Binding IsTodayActive}"
                    Command="{Binding ShowTodayCommand}"
                    Content="Today" />
            <Button Classes="nav"
                    Classes.active="{Binding IsStatisticsActive}"
                    Command="{Binding ShowStatisticsCommand}"
                    Content="Statistics" />
            <Button Classes="nav"
                    Classes.active="{Binding IsSettingsActive}"
                    Command="{Binding ShowSettingsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Width="16" Height="16"
                        Data="{StaticResource IconGear}"
                        Stroke="{Binding $parent[Button].Foreground}" />
                <TextBlock Text="Settings" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>

    <v:ConfirmDialogView DataContext="{Binding Dialog}" />
  </Grid>
</Window>
