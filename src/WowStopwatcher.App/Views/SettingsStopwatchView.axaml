<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:WowStopwatcher.App.Controls"
             xmlns:l="using:WowStopwatcher.App.Layout"
             xmlns:vm="using:WowStopwatcher.App.ViewModels"
             x:Class="WowStopwatcher.App.Views.SettingsStopwatchView"
             x:DataType="vm:SettingsStopwatchViewModel">

  <UserControl.Resources>
    <BoxShadows x:Key="SettingsShadowSelected">0 0 0 2 #151821</BoxShadows>
    <StreamGeometry x:Key="SettingsIconTrash">M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,19 A2,2 0 0 0 9,21 H15 A2,2 0 0 0 17,19 L18,7 M9,7 V4 H15 V7</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.goal">
      <Setter Property="Width" Value="112" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.goal:disabled">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
    </Style>
    <Style Selector="StackPanel.goalRow.off">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Color swatch -->
    <Style Selector="Button.swatch">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.swatchFace">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.swatchFace.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource OnDarkBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource SettingsShadowSelected}" />
    </Style>

    <!-- Shortcut recorder -->
    <Style Selector="Border.recorder">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
    </Style>
    <Style Selector="Border.recorder.recording">
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.recorder.warn">
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.recorder > Grid > TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Border.recorder > Grid > TextBlock.placeholder">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Border.recorder.recording > Grid > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="Border.recorder.warn > Grid > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.hint.warn">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card rowCard"
          Classes.dragging="{Binding IsDragging}"
          Classes.drop="{Binding IsDropTarget}">
    <Grid>
      <Button x:Name="GripButton"
              Classes="grip"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Width="28"
              Margin="10,16,0,16"
              AutomationProperties.Name="{Binding GripLabel}">
        <Button.KeyBindings>
          <KeyBinding Gesture="Up" Command="{Binding MoveUpCommand}" />
          <KeyBinding Gesture="Down" Command="{Binding MoveDownCommand}" />
        </Button.KeyBindings>
        <c:Icon Width="14" Height="20"
                ViewWidth="14" ViewHeight="20"
                Data="{StaticResource IconGrip}"
                Fill="{Binding $parent[Button].Foreground}"
                StrokeThickness="0" />
      </Button>

      <Button Classes="danger"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Width="40"
              Height="40"
              Padding="0"
              Margin="0,16,16,0"
              Command="{Binding DeleteCommand}"
              AutomationProperties.Name="{Binding DeleteLabel}">
        <c:Icon Width="16" Height="16"
                Data="{StaticResource SettingsIconTrash}"
                Stroke="{Binding $parent[Button].Foreground}" />
      </Button>

      <l:FlexWrapPanel Spacing="24" Margin="52,18,72,18">
        <!-- Name -->
        <StackPanel l:FlexWrapPanel.Basis="220" Spacing="6">
          <TextBlock Classes="fieldLabel" Text="Name" />
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="14" Height="14"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Background="{Binding Brush}" />
            <TextBox x:Name="NameBox"
                     Grid.Column="1"
                     Classes="field"
                     Text="{Binding Name}"
                     AutomationProperties.Name="Name" />
          </Grid>
        </StackPanel>

        <!-- Color -->
        <StackPanel l:FlexWrapPanel.Basis="220" Spacing="6">
          <TextBlock Classes="fieldLabel" Text="Color" />
          <ItemsControl ItemsSource="{Binding Swatches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsSwatchViewModel">
                <Button Classes="swatch"
                        Command="{Binding PickCommand}"
                        AutomationProperties.Name="{Binding Label}">
                  <Border Classes="swatchFace"
                          Classes.selected="{Binding IsSelected}"
                          Background="{Binding Brush}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Goal -->
        <StackPanel l:FlexWrapPanel.Basis="220" Spacing="6">
          <CheckBox IsChecked="{Binding HasGoal}"
                    MinHeight="20"
                    AutomationProperties.Name="Daily goal">
            <TextBlock Classes="fieldLabel" Text="Daily goal" />
          </CheckBox>
          <StackPanel Classes="goalRow"
                      Classes.off="{Binding !HasGoal}"
                      Orientation="Horizontal"
                      Spacing="8">
            <TextBox x:Name="GoalBox"
                     Classes="field goal"
                     IsEnabled="{Binding HasGoal}"
                     Text="{Binding GoalText, Mode=OneWay}"
                     ContextFlyout="{x:Null}"
                     AutomationProperties.Name="{Binding GoalLabel}" />
            <TextBlock Text="hh:mm:ss" FontSize="12" VerticalAlignment="Center" Classes="muted" />
          </StackPanel>
        </StackPanel>

        <!-- Shortcut -->
        <StackPanel l:FlexWrapPanel.Basis="220" Spacing="6">
          <TextBlock Classes="fieldLabel" Text="Start / Stop shortcut" />
          <Border x:Name="Recorder"
                  Classes="recorder"
                  Classes.recording="{Binding IsRecording}"
                  Classes.warn="{Binding HasShortcutWarning}"
                  AutomationProperties.Name="Start / Stop shortcut">
            <Grid>
              <TextBlock Text="{Binding ShortcutText}"
                         IsVisible="{Binding ShortcutText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="placeholder"
                         Text="{Binding ShortcutPlaceholder}"
                         IsVisible="{Binding ShortcutText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
            </Grid>
          </Border>
          <TextBlock Classes="hint"
                     Classes.warn="{Binding HasShortcutWarning}"
                     Text="{Binding ShortcutHint}" />
        </StackPanel>
      </l:FlexWrapPanel>
    </Grid>
  </Border>
</UserControl>
