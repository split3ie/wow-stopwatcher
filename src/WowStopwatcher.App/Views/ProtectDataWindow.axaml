<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WowStopwatcher.App.Controls"
        xmlns:loc="using:WowStopwatcher.App.Localization"
        xmlns:vm="using:WowStopwatcher.App.ViewModels"
        x:Class="WowStopwatcher.App.Views.ProtectDataWindow"
        x:DataType="vm:ProtectDataViewModel"
        Icon="/Assets/app.ico"
        Title="WowStopwatcher"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CardBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="14">

  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="-0.4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
    </Style>
    <Style Selector="TextBox.pin">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LetterSpacing" Value="4.5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.pin:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.confirm">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.confirm:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource GripBrush}" />
    </Style>
    <Style Selector="Button.copy">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="c|Icon.spin">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <StackPanel Margin="24" Spacing="16">

    <!-- Step 1: PIN -->
    <StackPanel Spacing="16" IsVisible="{Binding IsPinStep}">
      <StackPanel Spacing="8">
        <TextBlock Classes="heading" Text="{Binding Title}" />
        <TextBlock Text="{Binding Intro}"
                   LineHeight="21"
                   Foreground="{DynamicResource SecondaryBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Classes="fieldLabel" Text="{loc:T protect.pin}" />
        <TextBox Classes="pin"
                 Text="{Binding Pin}"
                 PasswordChar="●"
                 MaxLength="8"
                 IsEnabled="{Binding PinEnabled}"
                 ContextFlyout="{x:Null}"
                 AutomationProperties.Name="{loc:T protect.pin}" />
        <TextBlock Text="{loc:T protect.pinHint}"
                   FontSize="11"
                   Foreground="{DynamicResource MutedBrush}" />
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Classes="fieldLabel" Text="{loc:T protect.confirmPin}" />
        <TextBox Classes="pin"
                 Text="{Binding ConfirmPin}"
                 PasswordChar="●"
                 MaxLength="8"
                 IsEnabled="{Binding PinEnabled}"
                 ContextFlyout="{x:Null}"
                 AutomationProperties.Name="{loc:T protect.confirmPin}" />
      </StackPanel>
      <CheckBox IsChecked="{Binding NoPin}" MinHeight="20">
        <TextBlock Text="{loc:T protect.noPin}" FontSize="13" FontWeight="Medium" />
      </CheckBox>
      <TextBlock Text="{Binding PinError}"
                 IsVisible="{Binding HasPinError}"
                 FontSize="12"
                 Foreground="{DynamicResource DangerBrush}"
                 TextWrapping="Wrap" />
      <Button Classes="primary confirm"
              Command="{Binding ContinueCommand}"
              Content="{loc:T protect.continue}" />
    </StackPanel>

    <!-- Step 2: recovery code, then the working state -->
    <StackPanel Spacing="16" IsVisible="{Binding IsCodeStep}">
      <TextBlock Classes="heading" Text="{loc:T protect.codeTitle}" />
      <Border Padding="16,14"
              Background="{DynamicResource PageBrush}"
              BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <StackPanel Spacing="10">
          <SelectableTextBlock Text="{Binding RecoveryCode}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               LetterSpacing="0.34"
                               TextWrapping="Wrap" />
          <Button Classes="secondary copy"
                  IsVisible="{Binding CanEditCode}"
                  Command="{Binding CopyCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Width="14" Height="14"
                      Data="{StaticResource IconCopy}"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.8" />
              <TextBlock Text="{Binding CopyText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
      <Border Padding="12,10"
              IsVisible="{Binding CanEditCode}"
              Background="{DynamicResource StarSoftBrush}"
              CornerRadius="{DynamicResource RadiusControl}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <c:Icon Width="16" Height="16"
                  VerticalAlignment="Top"
                  Margin="0,1,0,0"
                  Data="{StaticResource IconInfo}"
                  Stroke="{DynamicResource ReachedAccentBrush}"
                  StrokeThickness="2" />
          <TextBlock Grid.Column="1"
                     Text="{loc:T protect.codeWarning}"
                     FontSize="13"
                     LineHeight="19"
                     Foreground="{DynamicResource ReachedAccentBrush}"
                     TextWrapping="Wrap" />
        </Grid>
      </Border>
      <CheckBox IsChecked="{Binding Saved}"
                IsEnabled="{Binding CanEditCode}"
                MinHeight="20">
        <TextBlock Text="{loc:T protect.saved}" FontSize="13" FontWeight="Medium" />
      </CheckBox>
      <StackPanel Spacing="8" IsVisible="{Binding IsWorking}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:Icon Classes="spin"
                  Width="14" Height="14"
                  Data="{StaticResource IconSpinner}"
                  Stroke="{DynamicResource AccentBrush}"
                  StrokeThickness="2.2" />
          <TextBlock Text="{Binding WorkingText}"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryBrush}" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True"
                     Height="6"
                     MinHeight="6"
                     CornerRadius="{DynamicResource RadiusPill}"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource BorderBrush}" />
        <TextBlock Text="{loc:T protect.dontClose}"
                   FontSize="12"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Button Classes="primary confirm"
              Command="{Binding EncryptCommand}"
              Content="{loc:T protect.encrypt}" />
    </StackPanel>
  </StackPanel>
</Window>
