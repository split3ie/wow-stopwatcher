<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="using:WowStopwatcher.App.Controls"
                xmlns:l="using:WowStopwatcher.App.Layout"
                xmlns:vm="using:WowStopwatcher.App.ViewModels"
                xmlns:v="using:WowStopwatcher.App.Views"
                x:Class="WowStopwatcher.App.Views.SettingsView"
                x:DataType="vm:SettingsViewModel">

  <UserControl.Resources>
    <SolidColorBrush x:Key="SettingsSuccessBrush" Color="#1F7A45" />
    <StreamGeometry x:Key="SettingsIconPlus">M12,5 V19 M5,12 H19</StreamGeometry>
    <StreamGeometry x:Key="SettingsIconRefresh">M21,12 A9,9 0 1 1 18,5.3 L21,8 M21,3 V8 H16</StreamGeometry>
    <StreamGeometry x:Key="SettingsIconSpinner">M21,12 A9,9 0 1 1 14.8,3.4</StreamGeometry>
    <StreamGeometry x:Key="SettingsIconGitHub">M9,19 c-4.3,1.4 -4.3,-2.5 -6,-3 m12,5 v-3.5 c0,-1 .1,-1.4 -.5,-2 c2.8,-.3 5.5,-1.4 5.5,-6 a4.6,4.6 0 0 0 -1.3,-3.2 a4.2,4.2 0 0 0 -.1,-3.2 s-1.1,-.3 -3.5,1.3 a12.3,12.3 0 0 0 -6.2,0 C6.5,2.8 5.4,3.1 5.4,3.1 a4.2,4.2 0 0 0 -.1,3.2 A4.6,4.6 0 0 0 4,9.5 c0,4.6 2.7,5.7 5.5,6 c-.6,.6 -.6,1.2 -.5,2 V21</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="-0.18" />
    </Style>

    <!-- On/off switch -->
    <Style Selector="ToggleButton.switch">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Track"
                  CornerRadius="{DynamicResource RadiusPill}"
                  Background="{DynamicResource IdleBrush}">
            <Ellipse x:Name="Knob"
                     Width="22" Height="22"
                     Margin="3,0,0,0"
                     HorizontalAlignment="Left"
                     Fill="{DynamicResource OnDarkBrush}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Ellipse#Knob">
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="ToggleButton.switch:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Footer links -->
    <Style Selector="Button.footerLink">
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.footerLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="Button.footerLink TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button.footerLink:pointerover TextBlock">
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style Selector="Button.checkUpdates">
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.updateMessage">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.updateMessage.ok">
      <Setter Property="Foreground" Value="{DynamicResource SettingsSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.updateMessage.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Spinner -->
    <Style Selector="c|Icon.spin">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- "Add new stopwatch" dashed button -->
    <Style Selector="Button.addDashed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="56" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.addDashed:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.addDashed:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border MaxWidth="920" Padding="28,28,28,32">
      <StackPanel Spacing="16">
        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" LetterSpacing="-0.48" />

        <!-- General -->
        <StackPanel Spacing="10" Margin="0,0,0,12">
          <TextBlock Classes="h2" Text="General" />
          <Border Classes="card" Padding="20,16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="Run with computer start" FontWeight="SemiBold" />
                <TextBlock Classes="muted"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Text="Opens WowStopwatcher in the system tray when you sign in to Windows. No stopwatch starts by itself." />
                <TextBlock Foreground="{DynamicResource DangerBrush}"
                           FontSize="13"
                           Text="{Binding AutostartError}"
                           IsVisible="{Binding AutostartError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <ToggleButton Grid.Column="1"
                            Classes="switch"
                            IsEnabled="{Binding IsAutostartSupported}"
                            IsChecked="{Binding AutostartEnabled}"
                            AutomationProperties.Name="Run with computer start" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- Stopwatches -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="Stopwatches" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Name, color, goal and shortcut for each activity. Drag the handle to change the order." />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="primary"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="12,0,0,0"
                  Padding="18,0"
                  Command="{Binding AddStopwatchCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Width="16" Height="16"
                      Data="{StaticResource SettingsIconPlus}"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="2.2" />
              <TextBlock Text="Add stopwatch" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsStopwatchViewModel">
              <v:SettingsStopwatchView />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Classes="addDashed" Command="{Binding AddStopwatchCommand}">
          <Grid>
            <Rectangle RadiusX="12" RadiusY="12"
                       Stroke="{DynamicResource IdleBrush}"
                       StrokeThickness="1.5"
                       StrokeDashArray="4,3" />
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <c:Icon Width="16" Height="16"
                      Data="{StaticResource SettingsIconPlus}"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="2" />
              <TextBlock Text="Add new stopwatch" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Button>

        <!-- Footer -->
        <Border Margin="0,20,0,0"
                Padding="0,18,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
          <l:FlexWrapPanel Spacing="24">
            <WrapPanel l:FlexWrapPanel.Basis="440" l:FlexWrapPanel.Grow="1" VerticalAlignment="Center">
              <TextBlock Classes="muted" FontSize="13" Margin="0,0,14,0" VerticalAlignment="Center">
                <Run Text="WowStopwatcher" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text=" " /><Run Classes="mono" Text="{Binding VersionText}" />
              </TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Classes="muted" FontSize="13" Text="Made by " VerticalAlignment="Center" />
                <Button Classes="link footerLink"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Tag="https://github.com/split3ie"
                        Click="OnLinkClick">
                  <TextBlock Text="split3ie" />
                </Button>
              </StackPanel>
              <Button Classes="link footerLink"
                      FontSize="13"
                      Tag="https://github.com/split3ie/wow-stopwatcher"
                      Click="OnLinkClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Width="16" Height="16"
                          Data="{StaticResource SettingsIconGitHub}"
                          Stroke="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="GitHub repository" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <StackPanel l:FlexWrapPanel.Basis="340"
                        l:FlexWrapPanel.Grow="0"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
              <TextBlock Classes="updateMessage"
                         Classes.ok="{Binding IsUpdateOk}"
                         Classes.error="{Binding IsUpdateError}"
                         Text="{Binding UpdateMessage}"
                         IsVisible="{Binding HasUpdateMessage}" />
              <Button Classes="link footerLink"
                      FontSize="13"
                      VerticalAlignment="Center"
                      Tag="{Binding UpdateUrl}"
                      IsVisible="{Binding HasUpdateLink}"
                      Click="OnLinkClick">
                <TextBlock Text="{Binding UpdateMessage}" />
              </Button>
              <Button Classes="secondary checkUpdates"
                      Command="{Binding CheckUpdatesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:Icon Classes="spin"
                          Width="14" Height="14"
                          IsVisible="{Binding IsBusy}"
                          Data="{StaticResource SettingsIconSpinner}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="2.2" />
                  <c:Icon Width="14" Height="14"
                          IsVisible="{Binding IsIdle}"
                          Data="{StaticResource SettingsIconRefresh}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="2" />
                  <TextBlock Text="Check for updates" IsVisible="{Binding IsIdle}" VerticalAlignment="Center" />
                  <TextBlock Text="Checking…" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </l:FlexWrapPanel>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
