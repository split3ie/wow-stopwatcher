<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:WowStopwatcher.App.Controls"
             xmlns:l="using:WowStopwatcher.App.Layout"
             xmlns:vm="using:WowStopwatcher.App.ViewModels"
             x:Class="WowStopwatcher.App.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

  <UserControl.Resources>
    <!-- Checked checkboxes use the accent color of the design. -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource AccentStrongColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource AccentStrongColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource AccentStrongColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{DynamicResource AccentStrongColor}" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Header buttons -->
    <Style Selector="Button.danger.stat, Button.secondary.stat">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.secondary.stat:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.danger.stat:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- The day bar is a button that toggles the details -->
    <Style Selector="Button.bar">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.bar:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Selected day card: blue ring -->
    <Style Selector="Border.dayCard.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="19,15" />
    </Style>

    <!-- Restore button of a hidden stopwatch: visible only while the row is hovered or focused -->
    <Style Selector="Button.secondary.restore">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.secondary.restore.shown">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="CheckBox.pick">
      <Setter Property="Width" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border MaxWidth="1040" Padding="28,28,28,48">
      <StackPanel Spacing="14">

        <!-- Title and actions -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock Text="Statistics" FontSize="24" FontWeight="Bold" LetterSpacing="-0.48" />
            <TextBlock Classes="muted"
                       Margin="0,6,0,0"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Text="Daily sessions. Click a timeline to see totals per stopwatch." />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Bottom"
                      IsVisible="{Binding !IsSelecting}">
            <Button Classes="danger stat"
                    Command="{Binding ClearAllCommand}"
                    IsEnabled="{Binding HasDays}"
                    Content="Clear all" />
            <Button Classes="secondary stat"
                    Command="{Binding StartSelectCommand}"
                    IsEnabled="{Binding HasDays}"
                    Content="Select" />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Bottom"
                      IsVisible="{Binding IsSelecting}">
            <TextBlock Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedText}" />
            <Button Classes="danger stat"
                    Command="{Binding ClearSelectedCommand}"
                    IsEnabled="{Binding HasSelection}"
                    Content="Clear selected" />
            <Button Classes="secondary stat"
                    Command="{Binding CancelSelectCommand}"
                    Content="Cancel" />
          </StackPanel>
        </Grid>

        <!-- Legend -->
        <ItemsControl ItemsSource="{Binding Legend}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LegendItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,4">
                <Border Width="10" Height="10"
                        VerticalAlignment="Center"
                        CornerRadius="{DynamicResource RadiusLegend}"
                        Background="{Binding Brush}" />
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryBrush}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty state -->
        <Grid IsVisible="{Binding !HasDays}">
          <Rectangle RadiusX="12" RadiusY="12"
                     Fill="{DynamicResource CardBrush}"
                     Stroke="{DynamicResource LineBrush}"
                     StrokeThickness="1"
                     StrokeDashArray="4,3" />
          <TextBlock Classes="muted"
                     Margin="40"
                     HorizontalAlignment="Center"
                     FontSize="14"
                     Text="No statistics yet." />
        </Grid>

        <!-- Days -->
        <ItemsControl ItemsSource="{Binding Days}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DayViewModel">
              <Border Classes="card dayCard"
                      Classes.selected="{Binding IsSelected}"
                      Padding="20,16"
                      AutomationProperties.Name="{Binding Label}">
                <StackPanel>
                  <Grid ColumnDefinitions="Auto,*">
                    <CheckBox Classes="pick"
                              Margin="0,0,14,0"
                              IsVisible="{Binding Page.IsSelecting}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding SelectLabel}" />

                    <StackPanel Grid.Column="1" Spacing="8">
                      <!-- Day label, badges and total -->
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                          <Run FontSize="15" FontWeight="SemiBold" Text="{Binding Label}" /><Run Text=" " /><Run FontSize="13" Foreground="{DynamicResource MutedBrush}" Text="{Binding Sub}" />
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Border IsVisible="{Binding AllGoalsReached}"
                                  Padding="8,2"
                                  Background="{DynamicResource StarSoftBrush}"
                                  CornerRadius="{DynamicResource RadiusPill}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <c:Icon Width="12" Height="12"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource IconStar}"
                                      Fill="{DynamicResource StarBrush}"
                                      Stroke="{DynamicResource StarStrokeBrush}" />
                              <TextBlock VerticalAlignment="Center"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource ReachedAccentBrush}"
                                         Text="All goals reached" />
                            </StackPanel>
                          </Border>
                          <Border IsVisible="{Binding IsPartialGoals}"
                                  Padding="8,2"
                                  Background="{DynamicResource ChipBrush}"
                                  CornerRadius="{DynamicResource RadiusPill}">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryBrush}">
                              <Run Text="{Binding GoalsText}" /><Run Text=" goals" />
                            </TextBlock>
                          </Border>
                          <TextBlock Classes="mono"
                                     VerticalAlignment="Center"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Text="{Binding TotalText}" />
                        </StackPanel>
                      </Grid>

                      <!-- Bar -->
                      <Grid>
                        <Button Classes="bar"
                                Command="{Binding ToggleCommand}"
                                AutomationProperties.Name="{Binding ToggleLabel}">
                          <Border Background="{DynamicResource PageBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{DynamicResource RadiusControl}"
                                  ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding Segments}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <c:TrackPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="vm:DaySegmentViewModel">
                                  <Setter Property="(c:TrackPanel.Start)" Value="{Binding Start}" />
                                  <Setter Property="(c:TrackPanel.SpanWidth)" Value="{Binding Width}" />
                                </Style>
                              </ItemsControl.Styles>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DaySegmentViewModel">
                                  <c:HoverBorder Background="Transparent" IsActive="{Binding IsHovered, Mode=TwoWay}">
                                    <Grid>
                                      <Border Background="{Binding Brush}" />
                                      <ItemsControl IsVisible="{Binding HasLanes}" ItemsSource="{Binding Lanes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LaneViewModel">
                          <Border Background="{Binding Brush}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                                      <Border IsVisible="{Binding IsHovered}"
                                              IsHitTestVisible="False"
                                              Opacity="0.18"
                                              Background="{DynamicResource OnDarkBrush}" />
                                      <Rectangle Width="1"
                                                 HorizontalAlignment="Right"
                                                 Fill="{DynamicResource SegmentSeamBrush}" />
                                    </Grid>
                                  </c:HoverBorder>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </Button>

                        <c:TrackPanel IsHitTestVisible="False">
                          <Border Classes="tip"
                                  IsVisible="{Binding IsTipVisible}"
                                  c:TrackPanel.Placement="Above"
                                  c:TrackPanel.Start="{Binding TipPosition}"
                                  c:TrackPanel.Rise="8">
                            <StackPanel>
                              <TextBlock Classes="tipSub" Text="{Binding TipTitle}" />
                              <TextBlock Classes="tipTime" Text="{Binding TipTime}" />
                            </StackPanel>
                          </Border>
                        </c:TrackPanel>
                      </Grid>

                      <!-- Ticks -->
                      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto">
                        <TextBlock Classes="mono muted" FontSize="11" Text="{Binding Ticks[0]}" />
                        <TextBlock Grid.Column="2" Classes="mono muted" FontSize="11" Text="{Binding Ticks[1]}" />
                        <TextBlock Grid.Column="4" Classes="mono muted" FontSize="11" Text="{Binding Ticks[2]}" />
                        <TextBlock Grid.Column="6" Classes="mono muted" FontSize="11" Text="{Binding Ticks[3]}" />
                      </Grid>
                    </StackPanel>
                  </Grid>

                  <!-- Details -->
                  <Border IsVisible="{Binding IsExpanded}"
                          Margin="0,12,0,0"
                          Padding="0,14,0,0"
                          BorderBrush="{DynamicResource LineSoftBrush}"
                          BorderThickness="0,1,0,0">
                    <l:FlexWrapPanel Spacing="24">
                      <ItemsControl l:FlexWrapPanel.Basis="360"
                                    l:FlexWrapPanel.Grow="1"
                                    ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DayStopwatchRowViewModel">
                            <c:HoverBorder Background="Transparent" IsActive="{Binding IsActive, Mode=TwoWay}">
                            <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="12">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                <Border Width="10" Height="10"
                                        VerticalAlignment="Center"
                                        CornerRadius="{DynamicResource RadiusLegend}"
                                        Background="{Binding Brush}" />
                                <TextBlock Grid.Column="1"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Name}" />
                                <c:Icon Grid.Column="2"
                                        Width="13" Height="13"
                                        IsVisible="{Binding IsReached}"
                                        Data="{StaticResource IconStar}"
                                        Fill="{DynamicResource StarBrush}"
                                        Stroke="{DynamicResource StarStrokeBrush}"
                                        AutomationProperties.Name="Goal reached" />
                              </Grid>
                              <Border Grid.Column="1"
                                      Height="8"
                                      VerticalAlignment="Center"
                                      Background="{DynamicResource LineSoftBrush}"
                                      CornerRadius="{DynamicResource RadiusBar}"
                                      ClipToBounds="True">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ShareWidth}" />
                                    <ColumnDefinition Width="{Binding OvertimeWidth}" />
                                    <ColumnDefinition Width="{Binding RestWidth}" />
                                  </Grid.ColumnDefinitions>
                                  <!-- Normal and overtime parts form one rounded bar: a clipped rounded container
                                       over both columns, with the darkening overlay on the overtime column. -->
                                  <Border Grid.ColumnSpan="2"
                                          Background="{Binding Brush}"
                                          CornerRadius="{DynamicResource RadiusBar}"
                                          ClipToBounds="True">
                                    <Grid>
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ShareWidth}" />
                                        <ColumnDefinition Width="{Binding OvertimeWidth}" />
                                      </Grid.ColumnDefinitions>
                                      <Border Grid.Column="1" Background="{DynamicResource OvertimeOverlayBrush}" />
                                    </Grid>
                                  </Border>
                                </Grid>
                              </Border>
                              <TextBlock Grid.Column="2"
                                         Classes="mono"
                                         MinWidth="86"
                                         FontSize="13"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center"
                                         Text="{Binding TimeText}" />
                              <Button Grid.Column="1"
                                      Classes="secondary restore"
                                      Classes.shown="{Binding IsActive}"
                                      IsVisible="{Binding IsDeleted}"
                                      Command="{Binding RestoreCommand}"
                                      Content="Restore"
                                      AutomationProperties.Name="{Binding RestoreLabel}" />
                            </Grid>
                            </c:HoverBorder>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Grid l:FlexWrapPanel.Basis="200"
                            l:FlexWrapPanel.Grow="0"
                            VerticalAlignment="Top"
                            ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="16"
                            RowSpacing="6">
                        <TextBlock Classes="muted" FontSize="13" Text="Total" />
                        <TextBlock Grid.Column="1" Classes="mono" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" Text="{Binding TotalText}" />
                        <TextBlock Grid.Row="1" Classes="muted" FontSize="13" Text="Sessions" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" Text="{Binding SessionCountText}" />
                        <TextBlock Grid.Row="2" Classes="muted" FontSize="13" Text="Goals met" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" Text="{Binding GoalsText}" />
                      </Grid>
                    </l:FlexWrapPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
