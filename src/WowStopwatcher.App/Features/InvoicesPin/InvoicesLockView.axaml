<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:WowStopwatcher.App.Controls"
             xmlns:loc="using:WowStopwatcher.App.Localization"
             xmlns:vm="using:WowStopwatcher.App.Features.InvoicesPin"
             x:Class="WowStopwatcher.App.Features.InvoicesPin.InvoicesLockView"
             x:DataType="vm:InvoicesLockViewModel"
             IsVisible="{Binding IsLocked}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Features/InvoicesPin/InvoicesPinIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBox.lockPin">
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MaxLength" Value="8" />
      <Setter Property="PasswordChar" Value="●" />
      <Setter Property="LetterSpacing" Value="6" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.lockPin:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.lockPin.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="28">
    <Border Classes="card"
            Width="380"
            Padding="28,32,28,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <StackPanel Spacing="16">
        <Border Width="56" Height="56"
                CornerRadius="28"
                HorizontalAlignment="Center"
                Background="{DynamicResource AccentSoftBrush}">
          <c:Icon Width="26" Height="26"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="{StaticResource InvoicesPinIconLock}"
                  Stroke="{DynamicResource AccentStrongBrush}" />
        </Border>

        <StackPanel Spacing="4">
          <TextBlock HorizontalAlignment="Center"
                     FontSize="20"
                     FontWeight="Bold"
                     LetterSpacing="-0.4"
                     Text="{loc:T invoicing.pin.lock.title}" />
          <TextBlock Classes="muted"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{loc:T invoicing.pin.lock.subtitle}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SecondaryBrush}"
                     Text="{loc:T invoicing.pin.label}" />
          <TextBox x:Name="PinBox"
                   Classes="lockPin"
                   Classes.invalid="{Binding HasError}"
                   IsEnabled="{Binding !IsLockedOut}"
                   Text="{Binding Pin}"
                   AutomationProperties.Name="{loc:T invoicing.pin.label}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock FontSize="12"
                     Foreground="{DynamicResource DangerBrush}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasError}"
                     Text="{Binding Error}" />
        </StackPanel>

        <Border IsVisible="{Binding IsLockedOut}"
                Padding="10,8"
                Background="{DynamicResource StarSoftBrush}"
                CornerRadius="{DynamicResource RadiusControl}">
          <Grid ColumnDefinitions="Auto,*">
            <c:Icon Width="14" Height="14"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Data="{StaticResource IconInfo}"
                    Stroke="{DynamicResource ReachedAccentBrush}"
                    StrokeThickness="2" />
            <TextBlock Grid.Column="1"
                       FontSize="12"
                       Foreground="{DynamicResource ReachedAccentBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding LockoutText}" />
          </Grid>
        </Border>

        <Button Classes="primary"
                Height="44"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding UnlockCommand}"
                Content="{loc:T invoicing.pin.lock.unlock}" />

        <Button Classes="link"
                HorizontalAlignment="Center"
                Command="{Binding ForgotCommand}"
                Content="{loc:T invoicing.pin.lock.forgot}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
