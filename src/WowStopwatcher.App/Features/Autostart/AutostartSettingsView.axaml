<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:WowStopwatcher.App.Features.Autostart"
             x:Class="WowStopwatcher.App.Features.Autostart.AutostartSettingsView"
             x:DataType="local:AutostartSettingsViewModel">
  <Border Classes="card" Padding="20,16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
        <TextBlock Text="Run with computer start" FontWeight="SemiBold" />
        <TextBlock Classes="muted"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Text="Opens WowStopwatcher in the system tray when you sign in to Windows. No stopwatch starts by itself." />
        <TextBlock Foreground="{DynamicResource DangerBrush}"
                   FontSize="13"
                   Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <ToggleButton Grid.Column="1"
                    Classes="switch"
                    IsChecked="{Binding IsEnabled}"
                    AutomationProperties.Name="Run with computer start" />
    </Grid>
  </Border>
</UserControl>
