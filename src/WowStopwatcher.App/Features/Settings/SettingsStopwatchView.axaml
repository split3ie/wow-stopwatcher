<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:WowStopwatcher.App.Controls"
             xmlns:loc="using:WowStopwatcher.App.Localization"
             xmlns:l="using:WowStopwatcher.App.Layout"
             xmlns:vm="using:WowStopwatcher.App.Features.Settings"
             x:Class="WowStopwatcher.App.Features.Settings.SettingsStopwatchView"
             x:DataType="vm:SettingsStopwatchViewModel">

  <UserControl.Resources>
    <BoxShadows x:Key="SettingsShadowSelected">0 0 0 2 #151821</BoxShadows>
    <StreamGeometry x:Key="SettingsIconTrash">M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,19 A2,2 0 0 0 9,21 H15 A2,2 0 0 0 17,19 L18,7 M9,7 V4 H15 V7</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.goal">
      <Setter Property="Width" Value="112" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.goal:disabled">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
    </Style>
    <Style Selector="Border.info">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Help" />
    </Style>
    <Style Selector="StackPanel.goalRow.off">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Color picker button and popup -->
    <Style Selector="Button.colorPick">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.colorPick:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.colorPick:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GripBrush}" />
    </Style>
    <Style Selector="FlyoutPresenter.colorMenu">
      <Setter Property="Padding" Value="12,12,6,6" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>

    <!-- Color swatch -->
    <Style Selector="Button.swatch">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.swatchFace">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.swatchFace.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource OnDarkBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource SettingsShadowSelected}" />
    </Style>

    <!-- Shortcut recorder -->
    <Style Selector="Border.recorder">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
    </Style>
    <Style Selector="Border.recorder.recording">
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.recorder.warn">
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.recorder > Grid > TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Border.recorder > Grid > TextBlock.placeholder">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Border.recorder.recording > Grid > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="Border.recorder.warn > Grid > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.hint.warn">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card rowCard"
          Classes.lifted="{Binding IsDragging}">
    <Grid>
      <Button x:Name="GripButton"
              Classes="grip"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Width="28"
              Margin="10,12,0,12"
              AutomationProperties.Name="{Binding GripLabel}">
        <Button.KeyBindings>
          <KeyBinding Gesture="Up" Command="{Binding MoveUpCommand}" />
          <KeyBinding Gesture="Down" Command="{Binding MoveDownCommand}" />
        </Button.KeyBindings>
        <c:Icon Width="14" Height="20"
                ViewWidth="14" ViewHeight="20"
                Data="{StaticResource IconGrip}"
                Fill="{Binding $parent[Button].Foreground}"
                StrokeThickness="0" />
      </Button>

      <Button Classes="danger"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Width="40"
              Height="40"
              Padding="0"
              Margin="0,10,16,0"
              Command="{Binding DeleteCommand}"
              AutomationProperties.Name="{Binding DeleteLabel}">
        <c:Icon Width="16" Height="16"
                Data="{StaticResource SettingsIconTrash}"
                Stroke="{Binding $parent[Button].Foreground}" />
      </Button>

      <l:FlexWrapPanel Margin="52,14,72,14" Spacing="28">
        <!-- Basics -->
        <StackPanel l:FlexWrapPanel.Basis="340" l:FlexWrapPanel.Grow="2" Spacing="8">
          <TextBlock Classes="section" Text="{loc:T settings.stopwatch.basics}" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
            <!-- Name -->
            <TextBlock Classes="fieldLabel" VerticalAlignment="Center" Text="{loc:T settings.stopwatch.name}" />
            <TextBox x:Name="NameBox"
                     Grid.Column="1"
                     Classes="field"
                     Text="{Binding Name}"
                     AutomationProperties.Name="{loc:T settings.stopwatch.name}" />

            <!-- Color -->
            <TextBlock Grid.Row="1" Classes="fieldLabel" VerticalAlignment="Center" Text="{loc:T settings.stopwatch.color}" />
            <Button x:Name="ColorButton"
                    Grid.Row="1" Grid.Column="1"
                    Classes="colorPick"
                    AutomationProperties.Name="{Binding ColorLabel}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="colorMenu">
                  <StackPanel>
                    <StackPanel IsVisible="{Binding !IsCustomColorOpen}">
                      <ItemsControl x:Name="SwatchList" ItemsSource="{Binding Swatches}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SettingsSwatchViewModel">
                            <Button Classes="swatch"
                                    Command="{Binding PickCommand}"
                                    AutomationProperties.Name="{Binding Label}">
                              <Border Classes="swatchFace"
                                      Classes.selected="{Binding IsSelected}"
                                      Background="{Binding Brush}" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="secondary"
                              Margin="0,0,6,6"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Command="{Binding OpenCustomColorCommand}"
                              Content="{loc:T settings.stopwatch.customColor}" />
                    </StackPanel>
                    <StackPanel Width="260" Spacing="10" Margin="0,0,6,6"
                                IsVisible="{Binding IsCustomColorOpen}">
                      <ColorView Color="{Binding PendingColor, Mode=TwoWay}"
                                 IsAlphaEnabled="False"
                                 IsAlphaVisible="False"
                                 IsColorPaletteVisible="False"
                                 IsColorModelVisible="False"
                                 IsColorComponentsVisible="False"
                                 IsHexInputVisible="True" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="secondary"
                                Command="{Binding CancelCustomColorCommand}"
                                Content="{loc:T settings.stopwatch.back}" />
                        <Button Classes="primary"
                                Command="{Binding ApplyCustomColorCommand}"
                                Content="{loc:T settings.stopwatch.apply}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="16" Height="16"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Background="{Binding Brush}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding ColorName}" />
                <c:Icon Grid.Column="2"
                        Width="14" Height="14"
                        Data="{StaticResource IconChevronDown}"
                        Stroke="{Binding $parent[Button].Foreground}" />
              </Grid>
            </Button>

            <!-- Shortcut -->
            <TextBlock Grid.Row="2" Classes="fieldLabel" VerticalAlignment="Center"
                       IsVisible="{Binding AreShortcutsAvailable}"
                       Text="{loc:T settings.stopwatch.shortcut}" />
            <Border x:Name="Recorder"
                    Grid.Row="2" Grid.Column="1"
                    Classes="recorder"
                    Classes.recording="{Binding IsRecording}"
                    Classes.warn="{Binding HasShortcutWarning}"
                    IsVisible="{Binding AreShortcutsAvailable}"
                    ToolTip.Tip="{loc:T settings.stopwatch.shortcutTip}"
                    AutomationProperties.Name="{loc:T settings.stopwatch.shortcutLabel}">
              <Grid>
                <TextBlock Text="{Binding ShortcutText}"
                           IsVisible="{Binding ShortcutText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="placeholder"
                           Text="{Binding ShortcutPlaceholder}"
                           IsVisible="{Binding ShortcutText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              </Grid>
            </Border>
            <!-- Live feedback and warnings stay visible; the idle hint is empty, so it lives in the recorder tooltip. -->
            <TextBlock Grid.Row="3" Grid.Column="1"
                       Classes="hint"
                       Classes.warn="{Binding HasShortcutHintWarning}"
                       TextWrapping="Wrap"
                       Text="{Binding ShortcutHint}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="AreShortcutsAvailable" />
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="HasShortcutHintWarning" />
                    <Binding Path="IsRecording" />
                  </MultiBinding>
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
          </Grid>
        </StackPanel>

        <!-- Goal and Behavior -->
        <StackPanel l:FlexWrapPanel.Basis="250" Spacing="20">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
              <Binding Path="AreGoalsAvailable" />
              <Binding Path="AreBehaviorOptionsAvailable" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <!-- Goal -->
          <StackPanel Spacing="8" IsVisible="{Binding AreGoalsAvailable}">
            <TextBlock Classes="section" Text="{loc:T settings.stopwatch.goal}" />
            <WrapPanel Orientation="Horizontal">
              <CheckBox IsChecked="{Binding HasGoal}"
                        Margin="0,0,16,0"
                        MinHeight="20"
                        AutomationProperties.Name="{loc:T settings.stopwatch.dailyGoal}">
                <TextBlock Classes="fieldLabel" Text="{loc:T settings.stopwatch.dailyGoal}" />
              </CheckBox>

              <!-- Carry goal over -->
              <StackPanel Classes="goalRow" Classes.off="{Binding !HasGoal}"
                          Orientation="Horizontal" Spacing="6">
                <CheckBox IsChecked="{Binding GoalPerCycle}"
                          IsEnabled="{Binding HasGoal}"
                          MinHeight="20"
                          AutomationProperties.Name="{loc:T settings.stopwatch.carryOver}">
                  <TextBlock Classes="fieldLabel" Text="{loc:T settings.stopwatch.carryOver}" />
                </CheckBox>
                <Border Classes="info"
                        ToolTip.Tip="{loc:T settings.stopwatch.carryOverInfo}"
                        AutomationProperties.Name="{loc:T settings.stopwatch.carryOverInfoLabel}"
                        AutomationProperties.HelpText="{loc:T settings.stopwatch.carryOverInfo}">
                  <c:Icon Width="14" Height="14"
                          Data="{StaticResource IconInfo}"
                          Stroke="{DynamicResource MutedBrush}" />
                </Border>
              </StackPanel>
            </WrapPanel>
            <Button Classes="secondary"
                    HorizontalAlignment="Left"
                    Command="{Binding StartNewCycleCommand}"
                    Content="{loc:T settings.stopwatch.newCycle}">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasGoal" />
                  <Binding Path="GoalPerCycle" />
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <StackPanel Classes="goalRow"
                        Classes.off="{Binding !HasGoal}"
                        Orientation="Horizontal"
                        Spacing="8">
              <TextBox x:Name="GoalBox"
                       Classes="field goal"
                       IsEnabled="{Binding HasGoal}"
                       Text="{Binding GoalText, Mode=OneWay}"
                       ContextFlyout="{x:Null}"
                       AutomationProperties.Name="{Binding GoalLabel}" />
              <TextBlock Text="{loc:T settings.stopwatch.goalFormat}" FontSize="12" VerticalAlignment="Center" Classes="muted" />
            </StackPanel>
          </StackPanel>

          <!-- Behavior -->
          <StackPanel Spacing="8" IsVisible="{Binding AreBehaviorOptionsAvailable}">
            <TextBlock Classes="section" Text="{loc:T settings.stopwatch.behavior}" />
            <StackPanel Spacing="6">
              <!-- Independent -->
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsIndependentAvailable}">
                <CheckBox IsChecked="{Binding IsIndependent}"
                          MinHeight="20"
                          AutomationProperties.Name="{loc:T settings.stopwatch.independent}">
                  <TextBlock Classes="fieldLabel" Text="{loc:T settings.stopwatch.independent}" />
                </CheckBox>
                <Border Classes="info"
                        ToolTip.Tip="{loc:T settings.stopwatch.independentInfo}"
                        AutomationProperties.Name="{loc:T settings.stopwatch.independentInfoLabel}"
                        AutomationProperties.HelpText="{loc:T settings.stopwatch.independentInfo}">
                  <c:Icon Width="14" Height="14"
                          Data="{StaticResource IconInfo}"
                          Stroke="{DynamicResource MutedBrush}" />
                </Border>
              </StackPanel>

              <!-- Permanent -->
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPermanentAvailable}">
                <CheckBox IsChecked="{Binding IsPermanent}"
                          MinHeight="20"
                          AutomationProperties.Name="{loc:T settings.stopwatch.permanent}">
                  <TextBlock Classes="fieldLabel" Text="{loc:T settings.stopwatch.permanent}" />
                </CheckBox>
                <Border Classes="info"
                        ToolTip.Tip="{loc:T settings.stopwatch.permanentInfo}"
                        AutomationProperties.Name="{loc:T settings.stopwatch.permanentInfoLabel}"
                        AutomationProperties.HelpText="{loc:T settings.stopwatch.permanentInfo}">
                  <c:Icon Width="14" Height="14"
                          Data="{StaticResource IconInfo}"
                          Stroke="{DynamicResource MutedBrush}" />
                </Border>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </l:FlexWrapPanel>
    </Grid>
  </Border>
</UserControl>
