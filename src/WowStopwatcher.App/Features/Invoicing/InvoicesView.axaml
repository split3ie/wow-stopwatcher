<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:WowStopwatcher.App.Controls"
             xmlns:loc="using:WowStopwatcher.App.Localization"
             xmlns:vm="using:WowStopwatcher.App.Features.Invoicing"
             x:Class="WowStopwatcher.App.Features.Invoicing.InvoicesView"
             x:DataType="vm:InvoicesViewModel">

  <StackPanel Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Classes="h2" Text="{loc:T invoicing.list.title}" />
      <TextBlock Classes="hint" VerticalAlignment="Center" Text="{loc:T invoicing.list.subtitle}" />
    </StackPanel>

    <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
    <TextBlock Classes="hint" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" Classes.error="{Binding IsStatusError}" />

    <Border Classes="card" Padding="16,12">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="1.2*,1.8*,110,150,100,110" ColumnSpacing="10" IsVisible="{Binding HasRows}">
          <TextBlock Classes="th" Text="{loc:T invoicing.list.month}" />
          <TextBlock Grid.Column="1" Classes="th" Text="{loc:T invoicing.list.file}" />
          <TextBlock Grid.Column="2" Classes="th" Text="{loc:T invoicing.list.hours}" />
          <TextBlock Grid.Column="3" Classes="th" Text="{loc:T invoicing.list.amount}" />
          <TextBlock Grid.Column="4" Classes="th" Text="{loc:T invoicing.list.status}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InvoiceRowViewModel">
              <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                <StackPanel Spacing="10">
                <Grid ColumnDefinitions="1.2*,1.8*,110,150,100,110" ColumnSpacing="10">
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding MonthText}" />
                    <Border Classes="pill inProgress" IsVisible="{Binding IsCurrent}">
                      <TextBlock Text="{loc:T invoicing.list.inProgress}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Classes="mono" FontSize="13"
                             Classes.muted="{Binding !HasFileName}"
                             Text="{Binding FileText}" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="mono" Text="{Binding HoursText}" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ReachedAccentBrush}"
                               Text="{Binding UnallocatedText}" IsVisible="{Binding HasUnallocated}" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                               Text="{Binding ReportedDifferenceText}" IsVisible="{Binding HasReported}" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="mono" Text="{Binding AmountText}" />
                  <Border Grid.Column="4" VerticalAlignment="Center" Classes="pill"
                          Classes.pending="{Binding IsPending}" Classes.sent="{Binding IsSent}">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>
                  <Button Grid.Column="5" Classes="outline" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="{loc:T invoicing.action.openFile}" Command="{Binding OpenFileCommand}" />
                        <MenuItem Header="{Binding GenerateText}" Command="{Binding GenerateCommand}" />
                        <MenuItem Header="{Binding MarkText}" Command="{Binding ToggleSentCommand}" />
                        <MenuItem Header="{loc:T invoicing.action.setReported}" Command="{Binding SetReportedCommand}" />
                        <MenuItem Header="{loc:T invoicing.action.showInFolder}" Command="{Binding ShowInFolderCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:T invoicing.action.showDetails}" Command="{Binding ShowDetailsCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{loc:T invoicing.list.actions}" />
                      <c:Icon Width="12" Height="12" Data="{StaticResource IconChevronDown}" Stroke="{Binding $parent[Button].Foreground}" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Border IsVisible="{Binding IsEditingReported}"
                        Padding="14,12"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusRow}">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:T invoicing.details.reported.label}" />
                      <TextBox Classes="field mono" Width="96" TextAlignment="Right"
                               PlaceholderText="160:00"
                               c:TimeMaskBehavior.Shape="000:00"
                               AutomationProperties.Name="{loc:T invoicing.details.reported.label}"
                               Text="{Binding ReportedInput}">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding SaveReportedCommand}" />
                          <KeyBinding Gesture="Escape" Command="{Binding CancelReportedCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                      <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding ReportedEditorLabel}" />
                      <Button Classes="primary apply" IsEnabled="{Binding CanSaveReported}"
                              Command="{Binding SaveReportedCommand}" Content="{loc:T invoicing.details.reported.save}" />
                      <Button Classes="outline" IsVisible="{Binding HasReported}"
                              Command="{Binding ClearReportedCommand}" Content="{loc:T invoicing.details.reported.clear}" />
                      <Button Classes="outline"
                              Command="{Binding CancelReportedCommand}" Content="{loc:T invoicing.details.cancel}" />
                    </StackPanel>
                    <TextBlock Classes="hint" Classes.error="{Binding ReportedInvalid}" Text="{Binding ReportedEditorHint}" />
                  </StackPanel>
                </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="hint" Text="{loc:T invoicing.list.empty}" IsVisible="{Binding !HasRows}" />
      </StackPanel>
    </Border>
    <TextBlock Classes="hint" Text="{loc:T invoicing.list.note}" />
  </StackPanel>
</UserControl>
