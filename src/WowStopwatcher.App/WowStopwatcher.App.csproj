<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyTitle>WowStopwatcher</AssemblyTitle>
    <Product>WowStopwatcher</Product>
    <Company>split3ie</Company>
    <Authors>split3ie</Authors>
  </PropertyGroup>
  <!-- Applied only by "dotnet publish" (sets _IsPublishing); build and run are unaffected. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <AssemblyName>WowStopwatcher</AssemblyName>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- Keep .pdb files (project and native package symbols) out of the publish output. -->
  <Target Name="RemovePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(_IsPublishing)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <AvaloniaResource Include="Assets/app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WowStopwatcher.Core\WowStopwatcher.Core.csproj" />
    <ProjectReference Include="..\WowStopwatcher.Data\WowStopwatcher.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
