<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyTitle>WowStopwatcher</AssemblyTitle>
    <Product>WowStopwatcher</Product>
    <Company>split3ie</Company>
    <Authors>split3ie</Authors>
  </PropertyGroup>
  <Import Project="Features.props" />
  <!-- Applied only by "dotnet publish" (sets _IsPublishing); build and run are unaffected. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <AssemblyName>WowStopwatcher</AssemblyName>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- Keep .pdb files (project and native package symbols) out of the publish output. -->
  <Target Name="RemovePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(_IsPublishing)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <!-- The release workflow passes -p:OfficialBuild=true; without it Settings shows "local build" instead of the version. -->
  <ItemGroup>
    <AssemblyMetadata Include="OfficialBuild" Value="true" Condition="'$(OfficialBuild)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WowStopwatcher.Core\WowStopwatcher.Core.csproj" />
    <ProjectReference Include="..\WowStopwatcher.Data\WowStopwatcher.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(FeatureInvoicing)' == 'true'">
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>
</Project>
