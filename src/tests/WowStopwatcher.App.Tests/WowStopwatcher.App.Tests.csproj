<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Same FEATURE_* defines as the App project, so tests follow the -p:Feature*=false flags. -->
  <Import Project="..\..\WowStopwatcher.App\Features.props" />

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Tests of a feature that is off are not compiled (same folder rule as the App project). -->
  <ItemGroup Condition="'$(FeatureInvoicing)' != 'true'">
    <Compile Remove="Invoicing/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(FeatureInvoicing)' == 'true'">
    <Compile Include="..\WowStopwatcher.Core.Tests\FakeRepositories.cs" Link="Invoicing\FakeRepositories.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FeatureInvoicesPin)' != 'true'">
    <Compile Remove="InvoicesPin/**" />
  </ItemGroup>

  <ItemGroup Condition="'$(FeatureSettings)' != 'true'">
    <Compile Remove="DataSettingsViewModelTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WowStopwatcher.App\WowStopwatcher.App.csproj" />
    <ProjectReference Include="..\..\WowStopwatcher.Data\WowStopwatcher.Data.csproj" />
    <ProjectReference Include="..\..\WowStopwatcher.Core\WowStopwatcher.Core.csproj" />
  </ItemGroup>

</Project>
